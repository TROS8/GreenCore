  "security": {
    "provider": "oauth2_google",
    "jwt_secret_env": "JWT_SECRET",
    "jwt_expiration_hours": 8,
    "roles": ["ADMIN", "OPERARIO", "VISUALIZADOR"],
    "gmail_notifications": true,
    "gmail_notify_on": ["ALERTA_CRITICO", "VENTA_COMPLETADA"],
    "public_endpoints": ["/api/v1/auth/**", "/swagger-ui/**", "/v3/api-docs/**"]
  },

  "automation": {
    "sensor_polling_cron": "0 */5 * * * *",
    "reporte_diario_cron": "0 0 7 * * *",
    "stock_minimo_alerta": 5,
    "auto_baja_planta_dias": 180
  },

  "i18n": {
    "default_locale": "es",
    "supported_locales": ["es", "en"],
    "backend_file": "messages_{locale}.properties",
    "frontend_file": "src/i18n/locales/{locale}.json"
  },

  "ci_cd": {
    "platform": "github_actions",
    "trigger_on": ["push", "pull_request"],
    "branches": ["main", "develop"],
    "steps": ["generate", "build_backend", "test_backend", "build_frontend", "test_api", "deploy"]
  },

  "documentation": {
    "openapi_path": "/swagger-ui/index.html",
    "javadoc_output": "docs/javadoc",
    "generate_data_dictionary": true,
