# GreenCore - Setup Admin
# Copia este archivo a .env y rellena con valores reales:
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)

# URL externa de PostgreSQL en Render
# Donde encontrarla: Render Dashboard -> Tu base de datos -> External Database URL
# Formato: postgresql://usuario:contrasena@host.render.com/nombre_db
DATABASE_URL=postgresql://usuario:contrasena@host.render.com/nombre_db

# Email de la cuenta Google con la que hiciste login en GreenCore
# Este usuario sera promovido a ADMIN
ADMIN_EMAIL=tu-email@gmail.com
