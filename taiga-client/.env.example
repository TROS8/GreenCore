# GreenCore — Taiga Connectivity Checker
# Copiar este archivo a .env y rellenar con los valores reales:
#   cp .env.example .env

# URL base de Taiga (por defecto la instancia pública)
TAIGA_URL=https://api.taiga.io

# Credenciales de tu cuenta Taiga
TAIGA_USERNAME=tu-usuario-taiga
TAIGA_PASSWORD=tu-contraseña-taiga

# Slug del proyecto en Taiga (aparece en la URL: taiga.io/project/<SLUG>)
TAIGA_PROJECT=greencore-invernadero
